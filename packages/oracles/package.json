{
  "name": "@tanstack/oracles",
  "version": "0.0.0",
  "description": "Oracle-based testing: laws, generated histories, independent models, and gap reports",
  "author": "Kyle Mathews",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/oracles.git",
    "directory": "packages/oracles"
  },
  "homepage": "https://github.com/TanStack/oracles",
  "keywords": [
    "testing",
    "property-based-testing",
    "oracle",
    "model-based-testing",
    "fast-check",
    "vitest"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./declaration": {
      "import": {
        "types": "./dist/esm/declaration.d.ts",
        "default": "./dist/esm/declaration.js"
      },
      "require": {
        "types": "./dist/cjs/declaration.d.cts",
        "default": "./dist/cjs/declaration.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "oracle-gaps": "./oracle-gaps/index.mjs"
  },
  "files": [
    "dist",
    "src",
    "oracle-gaps",
    "!oracle-gaps/**/*.property.test.mjs",
    "!oracle-gaps/gap-report-model-oracle.mjs",
    "!oracle-gaps/vitest.config.mjs",
    "!oracle-gaps/node_modules/**",
    "!oracle-gaps/.scratch-*",
    "!oracle-gaps/.scratch-*/**"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --fix",
    "test": "vitest --run",
    "test:oracle-framework": "vitest --run --config vitest.oracle-framework.config.mjs",
    "test:oracle-gaps": "vitest --run --config oracle-gaps/vitest.config.mjs",
    "test:oracle-gaps:fast": "vitest --run --config oracle-gaps/vitest.config.mjs gap-report-static gap-report-classify gap-report-probe-form",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "fast-check": "^4.0.0",
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "fast-check": "^4.10.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
