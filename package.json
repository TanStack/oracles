{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "pnpm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanStack/oracles.git"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "test": "pnpm --filter \"./packages/**\" test",
    "lint": "pnpm --filter \"./packages/**\" lint",
    "lint:check": "pnpm --filter \"./packages/**\" lint --fix=false",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter \"./packages/**\" typecheck",
    "format": "prettier --ignore-unknown '**/*' --write",
    "format:check": "prettier --ignore-unknown '**/*' --check",
    "changeset": "changeset",
    "test:publint": "pnpm --filter \"./packages/**\" exec publint --strict",
    "test:sherif": "sherif",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@tanstack/eslint-config": "0.3.4",
    "@tanstack/vite-config": "0.4.3",
    "@types/node": "^25.2.2",
    "eslint": "^9.39.2",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "publint": "^0.3.17",
    "sherif": "^1.10.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
